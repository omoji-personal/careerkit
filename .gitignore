# Everything personal. profile/ is the user's identity, claims, tracker and
# API keys; data/ is their database and HTTP cache; out/ is their reports.
# None of it belongs in git, including in a private repo.
profile/
data/
out/
.venv/
__pycache__/
*.pyc
.DS_Store
*.local.*
.pytest_cache/

# iCloud sync duplicates ("store 2.py"). These have been committed by
# accident before and one held stale code that would NameError if copied back.
*[0-9].py
* [0-9].*
